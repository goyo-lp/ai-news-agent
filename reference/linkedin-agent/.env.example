# Core providers
TAVILY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_STAGE_A_MODEL=openai/gpt-oss-120b
OPENROUTER_STAGE_A_SECONDARY_MODEL=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_POST_SECONDARY_MODEL=
OPENROUTER_VERIFIER_SECONDARY_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ai-linked-imposting-agent
DEEP_AGENT_ENABLED=true
DEEP_AGENT_MODEL=anthropic/claude-haiku-4.5
DEEP_AGENT_TIMEOUT_SECONDS=75
DEEP_AGENT_MAX_EVIDENCE_SOURCES=5
DEEP_AGENT_MAX_EVIDENCE_CHARS=1400
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Discovery + outputs
DISCOVERY_HOURS_BACK=48
DISCOVERY_MAX_RESULTS_PER_QUERY=8
DISCOVERY_MAX_CANDIDATES=60
MAX_TOPICS_PER_RUN=5
SEED_ARTICLES_PER_RUN=50
SOURCES_FILE=data/news-sources.yaml
TRUSTED_SOURCES_FILE=data/trusted-sources.yaml
STYLE_SAMPLES_DIR=style_samples
STYLE_PROFILE_FILE=data/style_profile.json
OUTPUTS_DIR=outputs

# HTTP
REQUEST_TIMEOUT_SECONDS=20
MAX_FEED_ITEMS_PER_SOURCE=50
RSS_HTTP_CONCURRENCY=8
TAVILY_HTTP_CONCURRENCY=6
VERIFICATION_SOURCES_PER_TOPIC=3
DEEP_RESEARCH_TOPIC_CONCURRENCY=4
ADAPTIVE_INVESTIGATION_CONCURRENCY=3
VERIFICATION_CONCURRENCY=4
TELEGRAM_SEND_CONCURRENCY=3
PIPELINE_BATCH_CONCURRENCY=2

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-linked-imposting-agent
