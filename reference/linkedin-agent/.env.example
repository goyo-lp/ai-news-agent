# LangGraphics
LANGGRAPHICS_ENABLED=true
LANGGRAPHICS_OPEN_BROWSER=true
LANGGRAPHICS_HOST=localhost
LANGGRAPHICS_PORT=8764
LANGGRAPHICS_WS_PORT=8765
LANGGRAPHICS_DIRECTION=TB
LANGGRAPHICS_MODE=auto
LANGGRAPHICS_INSPECT=off
LANGGRAPHICS_THEME=system
