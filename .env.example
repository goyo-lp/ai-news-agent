# Secrets in this file are placeholders. Real values for OPENROUTER_API_KEY,
# TELEGRAM_BOT_TOKEN, and LANGSMITH_API_KEY are secrets — never commit them
# (the real .env is gitignored). Rotate any key immediately if it is exposed.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI News Agent

# Stage A technical-ranker model + secondary (optional ensemble) for the
# technical_rank tool (P2.1). The legacy OPENROUTER_MODEL above stays the
# news pipeline's summarizer and is NOT Stage A.
OPENROUTER_STAGE_A_MODEL=openai/gpt-oss-120b
OPENROUTER_STAGE_A_SECONDARY_MODEL=

# Verifier model + optional ensemble secondary for the verify_claim tool (P2.4).
# Distinct from OPENROUTER_MODEL — the verifier fact-checker has its own model
# choice; coupling it to the news summarizer would silently entangle two
# products. VERIFICATION_CONCURRENCY bounds per-brief parallelism;
# VERIFICATION_SOURCES_PER_TOPIC bounds evidence depth per brief.
OPENROUTER_VERIFIER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_VERIFIER_SECONDARY_MODEL=
VERIFICATION_CONCURRENCY=4
VERIFICATION_SOURCES_PER_TOPIC=3

# Tavily research-evidence knobs (P2.3 tavily tools + P2.4 verify_claim reuse).
# Tavily stays ONLY as per-topic research evidence (Decision E) — discovery_*
# knobs are intentionally NOT ported. Optional until the research subagent is
# wired (Phase 4); keys absent -> dry-run no-ops.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TOPIC=news
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIME_RANGE=day
TAVILY_HTTP_CONCURRENCY=6

# Per-subagent model overrides (Stage B), deep-agent bounds, and orchestration
# limits land with their consumer (P3.1 linkedin-voice, P4.* subagents, P5.*
# coordinator) — not pre-declared here. A knob with no consumer is config
# dressed as code.

# Telegram — legacy top-level credentials double as the `news` bot profile.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Named bot profiles. Optional: the `news` profile falls back to the legacy
# fields above when these are unset; the `linkedin` profile is optional until
# its bot exists (no new required keys for dry-run).
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=
TELEGRAM_LINKEDIN_BOT_TOKEN=
TELEGRAM_LINKEDIN_CHAT_ID=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT="AI News Agent"
LANGSMITH_TRACING=true

SOURCES_FILE=data/news-sources.yaml
HISTORY_FILE=data/delivery-history.json
HISTORY_RETENTION_DAYS=14
REQUEST_TIMEOUT_SECONDS=20
HTTP_CONCURRENCY=8
MAX_FEED_ITEMS_PER_SOURCE=50
MAX_ARTICLES_PER_RUN=20
MAX_ARTICLES_PER_SOURCE=3
USER_AGENT=AINewsAgent/0.1

# Orchestrator filesystem convention (StateBackend lands in P5.1; this locates
# the dir the fetch_curated_ai_news tool writes to). outputs_dir /
# style_profile_file / style_samples_dir land with their consumer.
ORCHESTRATOR_DATA_DIR=data/orchestrator