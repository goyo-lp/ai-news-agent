# Secrets in this file are placeholders. Real values for OPENROUTER_API_KEY,
# TELEGRAM_BOT_TOKEN, and LANGSMITH_API_KEY are secrets — never commit them
# (the real .env is gitignored). Rotate any key immediately if it is exposed.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI News Agent

# Per-subagent model overrides (Stage A/B), Tavily research-evidence knobs,
# deep-agent bounds, and orchestration limits land with their consumer (P2.3
# tavily tools, P3.1 linkedin-voice, P4.* subagents, P5.* coordinator) — not
# pre-declared here. The legacy OPENROUTER_MODEL above remains the news
# pipeline's single model until then.

# Telegram — legacy top-level credentials double as the `news` bot profile.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Named bot profiles. Optional: the `news` profile falls back to the legacy
# fields above when these are unset; the `linkedin` profile is optional until
# its bot exists (no new required keys for dry-run).
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=
TELEGRAM_LINKEDIN_BOT_TOKEN=
TELEGRAM_LINKEDIN_CHAT_ID=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT="AI News Agent"
LANGSMITH_TRACING=true

SOURCES_FILE=data/news-sources.yaml
HISTORY_FILE=data/delivery-history.json
HISTORY_RETENTION_DAYS=14
REQUEST_TIMEOUT_SECONDS=20
HTTP_CONCURRENCY=8
MAX_FEED_ITEMS_PER_SOURCE=50
MAX_ARTICLES_PER_RUN=20
MAX_ARTICLES_PER_SOURCE=3
USER_AGENT=AINewsAgent/0.1

# Orchestrator filesystem convention (StateBackend lands in P5.1; this locates
# the dir the fetch_curated_ai_news tool writes to). outputs_dir /
# style_profile_file / style_samples_dir land with their consumer.
ORCHESTRATOR_DATA_DIR=data/orchestrator