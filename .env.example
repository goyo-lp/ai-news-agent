# Secrets in this file are placeholders. Real values for OPENROUTER_API_KEY,
# TELEGRAM_BOT_TOKEN, and LANGSMITH_API_KEY are secrets — never commit them
# (the real .env is gitignored). Rotate any key immediately if it is exposed.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI News Agent

# Stage A (cheap ranker) / Stage B (research + writer) model split, consumed by
# the coordinator's per-subagent overrides. The legacy OPENROUTER_MODEL above
# remains the news pipeline's summarization model and is NOT Stage A/B.
OPENROUTER_STAGE_A_MODEL=openai/gpt-oss-120b
OPENROUTER_STAGE_B_RESEARCH_MODEL=anthropic/claude-sonnet-5
OPENROUTER_STAGE_B_WRITER_MODEL=anthropic/claude-opus-4-8

# Tavily is used only as per-topic research evidence. Optional until the
# research subagent is wired (Phase 4); keys absent -> dry-run no-ops.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TOPIC=news
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIME_RANGE=day

# Deep-agent (coordinator + subagents) bounds.
DEEP_AGENT_ENABLED=true
DEEP_AGENT_MODEL=anthropic/claude-sonnet-5
DEEP_AGENT_TIMEOUT_SECONDS=75
DEEP_AGENT_MAX_EVIDENCE_SOURCES=5
DEEP_AGENT_MAX_EVIDENCE_CHARS=1400

# Coordinator orchestration bounds.
MAX_TOPICS_PER_RUN=5
DEEP_RESEARCH_TOPIC_CONCURRENCY=4
ADAPTIVE_INVESTIGATION_CONCURRENCY=3
TELEGRAM_SEND_CONCURRENCY=3

# Telegram — legacy top-level credentials double as the `news` bot profile.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Named bot profiles. Optional: the `news` profile falls back to the legacy
# fields above when these are unset; the `linkedin` profile is optional until
# its bot exists (no new required keys for dry-run).
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=
TELEGRAM_LINKEDIN_BOT_TOKEN=
TELEGRAM_LINKEDIN_CHAT_ID=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT="AI News Agent"
LANGSMITH_TRACING=true

SOURCES_FILE=data/news-sources.yaml
HISTORY_FILE=data/delivery-history.json
HISTORY_RETENTION_DAYS=14
REQUEST_TIMEOUT_SECONDS=20
HTTP_CONCURRENCY=8
MAX_FEED_ITEMS_PER_SOURCE=50
MAX_ARTICLES_PER_RUN=20
MAX_ARTICLES_PER_SOURCE=3
USER_AGENT=AINewsAgent/0.1

# Orchestrator filesystem conventions (StateBackend lands in P5.1).
ORCHESTRATOR_DATA_DIR=data/orchestrator
OUTPUTS_DIR=outputs
STYLE_PROFILE_FILE=data/style_profile.json
STYLE_SAMPLES_DIR=style_samples