# Local runtime
AI_NEWS_DATABASE_PATH=.local/ai-news-agent.db
AI_NEWS_LOG_LEVEL=INFO
AI_NEWS_LOG_FORMAT=json
AI_NEWS_ENVIRONMENT=local

# LangSmith tracing is opt-in. Never commit a real key.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-news-agent
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Model provider for editorial screening (PR06+). Never commit a real key.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
