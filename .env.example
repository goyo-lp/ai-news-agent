# Secrets in this file are placeholders. Real values for OPENROUTER_API_KEY,
# TELEGRAM_BOT_TOKEN, and LANGSMITH_API_KEY are secrets — never commit them
# (the real .env is gitignored). Rotate any key immediately if it is exposed.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI News Agent

# Decision J: every agent model defaults to deepseek/deepseek-v4-flash (the same
# model OPENROUTER_MODEL uses for news summarization). Each tier keeps its own
# knob below so it can be pointed elsewhere without disturbing the others.

# Stage A technical-ranker model + secondary (optional ensemble) for the
# technical_rank tool (P2.1). OPENROUTER_MODEL above is the news summarizer knob
# and is NOT Stage A.
OPENROUTER_STAGE_A_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_STAGE_A_SECONDARY_MODEL=

# Verifier model + optional ensemble secondary for the verify_claim tool (P2.4).
# Its own knob so the fact-checker can diverge from the news summarizer.
# VERIFICATION_CONCURRENCY bounds per-brief parallelism;
# VERIFICATION_SOURCES_PER_TOPIC bounds evidence depth per brief.
OPENROUTER_VERIFIER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VERIFIER_SECONDARY_MODEL=
VERIFICATION_CONCURRENCY=4
VERIFICATION_SOURCES_PER_TOPIC=3

# SearXNG research-evidence knobs (web_search tool + verify_claim reuse). Search
# runs against a self-hosted SearXNG instance — keyless, no billing. Start one
# with `docker compose -f docker-compose.searxng.yml up -d` and point
# SEARXNG_BASE_URL at it. Leave SEARXNG_BASE_URL empty to use deterministic
# dry-run mock results (no instance required). Per Decision E, search stays ONLY
# as per-topic research evidence; discovery is the RSS pipeline's job.
SEARXNG_BASE_URL=
SEARXNG_CATEGORIES=news
SEARXNG_LANGUAGE=en
SEARXNG_HTTP_CONCURRENCY=6

# Stage-B subagent models (P4.1 research, P4.2 writer). Decision J defaults both
# to deepseek/deepseek-v4-flash; the writer knob is the natural first upgrade if
# post voice quality warrants a stronger model.
OPENROUTER_STAGE_B_RESEARCH_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_STAGE_B_WRITER_MODEL=deepseek/deepseek-v4-flash

# Remaining deep-agent bounds and orchestration limits land with their consumer
# (P5.* coordinator) — not pre-declared here. A knob with no consumer is config
# dressed as code.

# Telegram — legacy top-level credentials double as the `news` bot profile.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Named bot profiles. The `news` profile falls back to the legacy fields above
# when these are unset. Set the `linkedin` profile to have `propose` deliver
# passing post proposals to that bot's chat; leave it empty and `propose` skips
# the send (dry-run). The two lanes can share one chat id or use separate ones.
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=
TELEGRAM_LINKEDIN_BOT_TOKEN=
TELEGRAM_LINKEDIN_CHAT_ID=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT="AI News Agent"
LANGSMITH_TRACING=true

SOURCES_FILE=data/news-sources.yaml
HISTORY_FILE=data/delivery-history.json
HISTORY_RETENTION_DAYS=14
REQUEST_TIMEOUT_SECONDS=20
HTTP_CONCURRENCY=8
MAX_FEED_ITEMS_PER_SOURCE=50
MAX_ARTICLES_PER_RUN=20
MAX_ARTICLES_PER_SOURCE=3
USER_AGENT=AINewsAgent/0.1

# Orchestrator filesystem convention (StateBackend lands in P5.1; this locates
# the dir the fetch_curated_ai_news tool writes to). outputs_dir /
# style_profile_file / style_samples_dir land with their consumer.
ORCHESTRATOR_DATA_DIR=data/orchestrator